---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getGameFilterOptions } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const { categories, publishers } = await getGameFilterOptions(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      {games.length > 0 && (
        <section
          class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
          aria-labelledby="game-filters-heading"
          data-testid="filters-section"
        >
          <h2 id="game-filters-heading" class="mb-4 text-lg font-semibold text-slate-100">
            Filter games
          </h2>
          <form id="game-filters" class="space-y-6" aria-label="Game filters">
            <fieldset>
              <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
              <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {categories.map((category) => (
                  <label
                    for={`category-filter-${category.id}`}
                    class="flex items-center gap-2 rounded-md border border-slate-700 bg-slate-900/60 px-3 py-2 text-slate-200 transition-colors hover:border-slate-500"
                  >
                    <input
                      id={`category-filter-${category.id}`}
                      type="checkbox"
                      name="category-filter"
                      value={String(category.id)}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
              <div class="max-w-md">
                <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
                  Publisher
                </label>
                <select
                  id="publisher-filter"
                  name="publisher-filter"
                  class="w-full rounded-md border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={String(publisher.id)}>{publisher.name}</option>
                  ))}
                </select>
              </div>

              <button
                id="clear-filters"
                type="button"
                class="inline-flex items-center justify-center rounded-md border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters-button"
              >
                Clear filters
              </button>
            </div>
          </form>
          <p id="filter-results-status" class="mt-3 text-sm text-slate-300" role="status" aria-live="polite">
            Showing {games.length} of {games.length} games
          </p>
          <p id="filtered-empty-state" class="mt-2 hidden text-sm text-slate-300" data-testid="filtered-empty-state">
            No games match the selected filters.
          </p>
        </section>
      )}

      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const filtersForm = document.getElementById('game-filters');
  const publisherFilter = document.getElementById('publisher-filter');
  const clearFiltersButton = document.getElementById('clear-filters');
  const statusElement = document.getElementById('filter-results-status');
  const filteredEmptyState = document.getElementById('filtered-empty-state');

  if (
    filtersForm instanceof HTMLFormElement &&
    publisherFilter instanceof HTMLSelectElement &&
    clearFiltersButton instanceof HTMLButtonElement &&
    statusElement instanceof HTMLParagraphElement &&
    filteredEmptyState instanceof HTMLParagraphElement
  ) {
    const categoryFilters = Array.from(
      filtersForm.querySelectorAll<HTMLInputElement>('input[name="category-filter"]')
    );
    const gameCards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')
    );
    const totalGames = gameCards.length;

    const applyFilters = () => {
      const selectedCategoryIds = new Set(
        categoryFilters.filter((input) => input.checked).map((input) => input.value)
      );
      const selectedPublisherId = publisherFilter.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = card.dataset.categoryId ?? '';
        const publisherId = card.dataset.publisherId ?? '';
        const categoryMatches =
          selectedCategoryIds.size === 0 || selectedCategoryIds.has(categoryId);
        const publisherMatches =
          selectedPublisherId === '' || selectedPublisherId === publisherId;
        const matches = categoryMatches && publisherMatches;

        card.hidden = !matches;
        if (matches) {
          visibleCount += 1;
        }
      }

      statusElement.textContent = `Showing ${visibleCount} of ${totalGames} games`;
      filteredEmptyState.classList.toggle('hidden', visibleCount > 0);
    };

    const syncUrl = () => {
      const url = new URL(window.location.href);
      const selectedCategoryIds = categoryFilters
        .filter((input) => input.checked)
        .map((input) => input.value);

      url.searchParams.delete('category');
      for (const categoryId of selectedCategoryIds) {
        url.searchParams.append('category', categoryId);
      }

      if (publisherFilter.value === '') {
        url.searchParams.delete('publisher');
      } else {
        url.searchParams.set('publisher', publisherFilter.value);
      }

      window.history.replaceState(null, '', `${url.pathname}${url.search}`);
    };

    const syncStateFromUrl = () => {
      const searchParams = new URLSearchParams(window.location.search);
      const selectedCategories = new Set(searchParams.getAll('category'));
      const selectedPublisher = searchParams.get('publisher') ?? '';

      for (const categoryFilter of categoryFilters) {
        categoryFilter.checked = selectedCategories.has(categoryFilter.value);
      }

      if (
        selectedPublisher !== '' &&
        Array.from(publisherFilter.options).some((option) => option.value === selectedPublisher)
      ) {
        publisherFilter.value = selectedPublisher;
      } else {
        publisherFilter.value = '';
      }
    };

    const handleFilterChange = () => {
      applyFilters();
      syncUrl();
    };

    syncStateFromUrl();
    applyFilters();

    for (const categoryFilter of categoryFilters) {
      categoryFilter.addEventListener('change', handleFilterChange);
    }
    publisherFilter.addEventListener('change', handleFilterChange);
    clearFiltersButton.addEventListener('click', () => {
      for (const categoryFilter of categoryFilters) {
        categoryFilter.checked = false;
      }
      publisherFilter.value = '';
      handleFilterChange();
    });
  }
</script>
